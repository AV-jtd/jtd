# ============================================================
# Supabase self-hosted — шаблон переменных окружения
# Скопируй в .env.supabase и заполни своими значениями
# ============================================================

# --- Домен и URL ---
SITE_URL=https://justtodoit.ru
API_EXTERNAL_URL=https://justtodoit.ru
ADDITIONAL_REDIRECT_URLS=

# --- PostgreSQL ---
# Придумай надёжный пароль (минимум 32 символа)
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ

# --- JWT (генерируются один раз, потом не менять!) ---
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ_32_СИМВОЛА
SECRET_KEY_BASE=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА

# --- API ключи (генерируются из JWT_SECRET) ---
# ANON_KEY и SERVICE_ROLE_KEY — JWT токены, подписанные JWT_SECRET.
# Используй: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# Или скрипт: node self-hosting/generate-keys.js
ANON_KEY=СГЕНЕРИРОВАТЬ
SERVICE_ROLE_KEY=СГЕНЕРИРОВАТЬ

# --- SMTP (для писем регистрации/сброса пароля) ---
# Можно использовать Яндекс 360, Mail.ru или Resend
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@justtodoit.ru
SMTP_PASS=ПАРОЛЬ_ОТ_ПОЧТЫ

# --- Supabase Dashboard (Studio UI) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ЗАМЕНИ_НА_ПАРОЛЬ

# --- Storage бэкенд ---
# По умолчанию: file (файлы хранятся в Docker-томе storage_data)
# Для S3: раскомментируй и заполни переменные ниже, затем перезапусти storage-контейнер
#
# STORAGE_BACKEND=s3
#
# Timeweb S3 (пример):
# STORAGE_S3_ENDPOINT=https://s3.timeweb.cloud
# STORAGE_S3_REGION=ru-1
# STORAGE_S3_BUCKET=jtd-storage
# STORAGE_S3_KEY_ID=ТВОЙ_ACCESS_KEY
# STORAGE_S3_SECRET=ТВОЙ_SECRET_KEY
# STORAGE_S3_FORCE_PATH_STYLE=true
#
# Selectel S3 (пример):
# STORAGE_S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
# STORAGE_S3_REGION=ru-1
# STORAGE_S3_BUCKET=jtd-storage
# STORAGE_S3_KEY_ID=ТВОЙ_ACCESS_KEY
# STORAGE_S3_SECRET=ТВОЙ_SECRET_KEY
# STORAGE_S3_FORCE_PATH_STYLE=true
#
# Максимальный размер файла (байт, default 50MB):
# STORAGE_FILE_SIZE_LIMIT=52428800

# --- Бэкапы PostgreSQL ---
# Локальный каталог для хранения дампов (монтируется в контейнер)
BACKUP_DIR=/backups
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
# Для внешнего диска: BACKUP_DIR=/mnt/backup-disk/jtd

# S3-совместимое хранилище для offsite-бэкапов (опционально)
# S3_ENDPOINT=https://s3.timeweb.cloud
# S3_BUCKET=jtd-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Секреты Edge Functions ---
TELEGRAM_BOT_TOKEN=СКОПИРОВАТЬ_ИЗ_SUPABASE_DASHBOARD_SECRETS
# LOVABLE_API_KEY больше не используется — заменяем на OpenRouter (см. README)
# Зарегистрируйся на openrouter.ai → Keys → Create key (бесплатный тир есть)
LOVABLE_API_KEY=OPENROUTER_API_KEY_СЮДА

# Мессенджер MAX (VK) — токен бота из кабинета MAX
MAX_BOT_TOKEN=MAX_BOT_TOKEN_СЮДА
