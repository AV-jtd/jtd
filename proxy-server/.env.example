# ── Провайдер ИИ ─────────────────────────────────────────────────────────────
# Выберите один: openrouter или anthropic
AI_PROVIDER=openrouter

# ── OpenRouter (рекомендуется) ────────────────────────────────────────────────
# Получить ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ── Anthropic (альтернатива) ──────────────────────────────────────────────────
# Получить ключ: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ── Модели (необязательно, есть умолчания) ────────────────────────────────────
# fast  = дешёвая модель для массовой категоризации писем
# smart = умная модель для анализа, обещаний, досье

# Примеры для OpenRouter:
# AI_MODEL_FAST=google/gemini-flash-1.5
# AI_MODEL_FAST=deepseek/deepseek-chat
# AI_MODEL_SMART=anthropic/claude-sonnet-4.6
# AI_MODEL_SMART=openai/gpt-4o

# Примеры для Anthropic:
# AI_MODEL_FAST=claude-haiku-4-5-20251001
# AI_MODEL_SMART=claude-sonnet-4-6

# ── Порт сервера ──────────────────────────────────────────────────────────────
# PORT=3000
